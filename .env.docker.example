# ==============================================================================
# Dravix SCM Production Environment Template for AWS EC2 (Docker Compose)
# Copy this file to .env.docker on your EC2 instance and fill in your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MySQL Database Configuration
# ------------------------------------------------------------------------------
MYSQL_DATABASE=supply_chain_db
MYSQL_USER=dravix_user
# Change this to a strong, random password for production
MYSQL_PASSWORD=change_me_to_a_secure_password_123
# Change root password for production
MYSQL_ROOT_PASSWORD=change_me_to_a_secure_root_password_123
MYSQL_PORT=3307

# ------------------------------------------------------------------------------
# 2. Spring Boot Backend Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=8082
# 64-byte base64 encoded JWT secret
JWT_SECRET=d2d5OTlhMzJmY2I3YTI1NzRlY2U4NWJiYWMyZDU2YjFhMmU4NWI5YmFjMmQ1NmIxYTJlODViOWI=
OPENAI_API_KEY=dummy-key

# Gmail SMTP Settings for OTP and Notifications (Optional, leave blank if not used)
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# AWS S3 Settings for Document Storage (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=
AWS_S3_RETENTION_DAYS=30
ENCRYPTION_SECRET=d2d5OTlhMzJmY2I3YTI1NzRlY2U4NWJiYWMyZDU2YjE=

# Government Market Price API (data.gov.in)
DATA_GOV_API_KEY=579b464db66ec23bdd000001cdd3946e44ce4aad7209ff7b23ac571b
SCHEDULER_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Frontend & CORS Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=80
# Set to your EC2 Public IP or Domain: e.g., http://13.233.xx.xx,http://localhost:80
SCMS_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80
