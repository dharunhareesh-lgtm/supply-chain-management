# Dravix SCM Environment Variables Example

# ==================================================
# BACKEND CONFIGURATIONS
# ==================================================
# Port mapping for backend server (defaults to 8082 if not specified)
PORT=8082

# JWT Authentication secret key (Must be a secure 256-bit base64-encoded string in production)
JWT_SECRET=d2d5OTlhMzJmY2I3YTI1NzRlY2U4NWJiYWMyZDU2YjFhMmU4NWI5YmFjMmQ1NmIxYTJlODViOWI=

# Database Connection URL (Choose either unified URL or individual MySQL vars)
# 1. Option A: Unified JDBC URL
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/supply_chain_db?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# 2. Option B: Individual MySQL service variables (e.g. Railway MySQL plugin auto-sets these)
MYSQLHOST=localhost
MYSQLPORT=3306
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=supply_chain_db

# Email SMTP credentials (Gmail App Password is recommended)
EMAIL_USERNAME=your_gmail_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# OpenAI API Key (Required for Spring AI startup configuration)
OPENAI_API_KEY=your_openai_api_key_here

# ==================================================
# FRONTEND CONFIGURATIONS (Vercel Environment Variables)
# ==================================================
# Deployed URL of backend server API
NEXT_PUBLIC_API_URL=https://your-backend-railway-url.up.railway.app

# Simulated Integrations (Optional placeholding)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_SECRET=rzp_test_placeholder_secret
GOOGLE_MAPS_API_KEY=google_maps_api_key_placeholder
SUPABASE_URL=supabase_url_placeholder
SUPABASE_ANON_KEY=supabase_anon_key_placeholder
